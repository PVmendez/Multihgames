{
  "name": "multijuegos",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "hash": "node scripts/hash-name.mjs"
  },
  "dependencies": {
    "blobatar": "^2.7.0",
    "leaflet": "^1.9.4",
    "mapillary-js": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "type": "module"
}
